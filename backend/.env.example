# Postgres (recommended)
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/retail_sync

# SQLite fallback (no setup required)
# DATABASE_URL=sqlite:///retail_sync.db

JWT_SECRET=change-me-in-production

# Alert mail. Leave SMTP_HOST empty to keep alerts in the app's bell only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# ALERT_INTERVAL_SECONDS=3600
