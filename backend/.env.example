# Copy this file to backend/.env and fill it in. .env is never committed.
# Development needs only DATABASE_URL. The server needs JWT_SECRET as well.

# --- Database ---------------------------------------------------------------
# Postgres (recommended; the site uses this). Use the real user, password and
# database name. Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/retail_sync

# SQLite fallback for development (no setup required)
# DATABASE_URL=sqlite:///retail_sync.db

# --- Security ---------------------------------------------------------------
# Set this on the server: a long random string (32+ characters recommended). The
# server starts with any value but logs a warning if it is missing or short.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every user out.
JWT_SECRET=change-me-in-production

# Other origins allowed to call the API, for example the Android app. The
# website is served by the same process and needs nothing here. Leave empty
# on the server unless the phone app is used.
# CORS_ORIGINS=https://localhost,http://localhost

# --- Where things are (all optional; defaults shown) -------------------------
# APP_ENV=development        # start-server.bat sets production
# FRONTEND_DIST=             # default: <app folder>\frontend\dist
# LOG_DIR=                   # default: backend\logs
# PG_BIN=C:\Program Files\PostgreSQL\16\bin   # only if pg_dump is not on PATH (db-dump.bat)

# --- Alert mail --------------------------------------------------------------
# Leave SMTP_HOST empty to keep alerts in the app's bell only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# SMTP_TLS=1
# ALERT_INTERVAL_SECONDS=3600

# --- AI assistant (optional) -------------------------------------------------
# Sends questions and store data to Google Gemini. Leave empty to keep it off
# (the chat then says it is not configured). Ask for approval before enabling.
# GOOGLE_API_KEY=
# LLM_MODEL=gemini-1.5-flash
